{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": false,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"lib": ["ESNext"],
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["vite.config.ts", "playwright.config.ts", "eslint.config.mjs"]
}
