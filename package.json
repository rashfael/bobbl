{
	"name": "bobbl",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc --noEmit && vite build",
		"preview": "vite preview",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:e2e": "playwright test",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "vue-tsc --noEmit",
		"deploy": "npm run build && rsync -avz --delete dist/ rash.codes:bobbl"
	},
	"dependencies": {
		"buntpapier": "^3.0.0-alpha.17",
		"vue": "^3.5.29",
		"vue-router": "^4.6.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@modyfi/vite-plugin-yaml": "^1.1.1",
		"@playwright/mcp": "^0.0.68",
		"@playwright/test": "^1.58.2",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^25.3.5",
		"@vitejs/plugin-vue": "^6.0.4",
		"@vue-macros/reactivity-transform": "^3.1.2",
		"@vue/language-plugin-pug": "^3.2.5",
		"@vue/typescript-plugin": "^3.2.5",
		"eslint": "^10.0.3",
		"eslint-plugin-vue": "^10.8.0",
		"eslint-plugin-vue-pug": "^1.0.0-alpha.5",
		"globals": "^17.4.0",
		"pug": "^3.0.3",
		"sass-embedded": "^1.97.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"vite": "^7.3.1",
		"vitest": "^4.0.18",
		"vue-tsc": "^3.2.5",
		"yaml": "^2.8.2"
	}
}
